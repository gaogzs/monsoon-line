        "TIPS": {
          "i0": {
            "s1": "发射包线：锁定框淡橙 = 射程外，橙色 = 射程内，<b>红色 = NEZ 不可逃逸区</b>，此时发射敌机极难摆脱。"
          },
          "i1": {
            "s1": "能量机动：爬升掉速、俯冲增速。低速时舵效下降，谨防失速。"
          },
          "i2": {
            "s1": "导弹规避：把来袭导弹放在 3/9 线（正横），持续桶滚消耗其能量。"
          },
          "i3": {
            "s1": "动压 Q：18 km 以上的空气密度只有海平面的约 10%。动压低于 22 kPa 舵效开始下降，低于 <b>12 kPa</b> 告警，导弹也拉不动过载；机炮射程则会变远。"
          },
          "i4": {
            "s1": "调节单元悬在 18–22 km：在它们附近谨慎使用重型武器，打坏一个会按误击友方设施扣分。"
          },
          "i5": {
            "s1": "注意高度：低于 200 m 触发低高度告警，坠海即任务失败。"
          }
        },
        "GUIDE": {
          "i0": {
            "title": "假如你想攻击敌人",
            "lead": "按 F / Tab 选中目标（屏幕边缘的红箭头指向屏外目标）。把它套进视场圈里，等锁定环走满。",
            "items": {
              "i0": {
                "name": "锁定环（实线）",
                "text": "目标在视场锥内、并进入锁定距离时，环才开始往前走；走满 = 锁定完成。"
              },
              "i1": {
                "name": "锁定环（虚线）",
                "text": "暗色虚线、进度往回掉，说明现在锁不上：目标在锥外或距离外，把机头带过去。"
              },
              "i2": {
                "text": "锁定完成，框变成双层角框，框上方写 LOCK，这时发射才有效。"
              },
              "i3": {
                "name": "框下无字",
                "text": "目标在最大射程之外（框为淡橙色）。打出去够不着，先接近。"
              },
              "i4": {
                "text": "在最大射程之内（框为橙色）。能追上，但目标掉头仍可能甩开。"
              },
              "i5": {
                "text": "不可逃逸区（框为红色）。目标立刻掉头也甩不掉，这时发射最有价值。"
              },
              "i6": {
                "name": "武器视场圈",
                "text": "拿导引弹时机头周围的圆：灰虚 = 没有目标；橙虚 = 在锥外或距离外；红实 = 能锁。对地弹是地平线上的两道竖线。"
              },
              "i7": {
                "name": "机炮预测圈（实线）",
                "text": "选中目标就出现。圆心是子弹该打到的点，已算上飞行时间、载机速度、重力和阻力。把圆心压到准星上开火；实线 = 目标在机炮射程内。目标机动时圈会跟着动，修正准星即可，不用盯着目标本身。"
              },
              "i8": {
                "name": "机炮预测圈（虚线）",
                "text": "目标在机炮有效射程之外（高空按高空射程算）。先机动接近，圈变实线后再开火。"
              }
            }
          },
          "i1": {
            "title": "假如敌人想攻击你",
            "lead": "敌人在锁你，或你被对空雷达截获时，屏幕上方会出现琥珀色的告警。",
            "items": {
              "i0": {
                "text": "被雷达照射，或被对空雷达截获。飞得越高越容易被截获，低空可以躲开。"
              },
              "i1": {
                "name": "RWR 威胁环",
                "text": "环上的点是威胁方向（机头朝上）。红点 = 约 2.6 km 内的近威胁；琥珀点 = 较远的威胁。"
              },
              "i2": {
                "name": "N 电磁静默",
                "text": "雷达关机、数据链断开、干扰机停辐射。敌人更难发现你，但你自己的锁定距离也会减半。"
              },
              "i3": {
                "name": "低空突防",
                "text": "贴近地形飞，对空雷达看不到你。但近距离的目视发现仍然有效。"
              },
              "i4": {
                "name": "僚机掩护",
                "text": "按 3 让僚机掩护。掩护机在你被导弹咬住时会主动撒干扰弹，替你争取脱离时间。"
              }
            }
          },
          "i2": {
            "title": "假如导弹瞄准你了",
            "lead": "红色闪烁的 MISSILE 会显示距离。立刻做两件事：长按 V 投干扰弹，同时机动。",
            "items": {
              "i0": {
                "text": "来袭导弹。闪烁红字下方是距离。不要等它到近处才动。"
              },
              "i1": {
                "name": "V 长按投干扰弹",
                "text": "热焰弹和箔丝同时撒出，每 0.45 秒一组。同一枚导弹每被投一次，骗中概率都会下降，所以别连按：投一两组，看它脱没脱锁，没脱就转向。光电与激光制导的导弹不吃干扰弹。"
              },
              "i2": {
                "name": "3 / 9 线机动",
                "text": "把导弹放在正横（机翼两侧），持续桶滚。导弹的导引需要转弯，横向切过去它很难跟上。"
              },
              "i3": {
                "name": "投弹后立刻转向",
                "text": "被骗的导弹会盲飞约 1.4 秒，然后重新找目标。投完弹马上大角度转向，等它重新捕获时你已经不在原来的位置了。"
              },
              "i4": {
                "name": "G 高 G 机动",
                "text": "按住 G 拉出额外过载，把导弹甩在身后，代价是掉速。高空动压低时过载拉不起来，这招会失效。"
              }
            }
          },
          "i3": {
            "title": "假如防空炮或防空导弹瞄准你了",
            "lead": "防空的威胁主要是雷达截获和导弹发射。近防炮只在近距离生效，远离它就安全。",
            "items": {
              "i0": {
                "name": "对空雷达截获",
                "text": "飞得太高会被对空雷达截获，各关的高度阈值不同（多在 1500–2600 m 以上）。低空突防可以躲开。"
              },
              "i1": {
                "name": "“发射！方位… 距离…”",
                "text": "无线电报出防空导弹的方位和距离。舰载雷达的探测距离约是导弹自身导引头的 1.5 倍，别停在它的探测范围里。"
              },
              "i2": {
                "name": "近防炮（CIWS）",
                "text": "舰艇的近防炮会在约 1.8 km 内拦截导弹。想打舰，尽量在远处发射制导弹。"
              },
              "i3": {
                "name": "脱离",
                "text": "降低高度借地形遮蔽，或拉出它的锁定距离，或开 N 静默。被干扰的雷达锁定距离和速度都会打折，这也是一种脱离方式。"
              }
            }
          }
        },
